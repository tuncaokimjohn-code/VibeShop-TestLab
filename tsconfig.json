{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": false,
    "types": [],
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "vulnerable/src/**/*.ts",
    "vulnerable/src/**/*.tsx",
    "safer/src/**/*.ts",
    "safer/src/**/*.tsx",
    "synthetic-data/*.json"
  ]
}
